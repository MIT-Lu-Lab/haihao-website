---
import { isExternal, navigation } from '../data/site';
interface Props { mobile?: boolean }
const { mobile = false } = Astro.props;
---
<nav aria-label={mobile ? 'Mobile navigation' : 'Main navigation'} class:list={['navigation', { 'mobile-navigation': mobile }]}>
  {navigation.map(({ label, href }) => (
    <a
      href={href}
      target={isExternal(href) ? '_blank' : undefined}
      rel={isExternal(href) ? 'noopener' : undefined}
      aria-current={Astro.url.pathname === href ? 'page' : undefined}
    >
      {label}{isExternal(href) && <span class="external-mark" aria-hidden="true">↗</span>}
    </a>
  ))}
</nav>
