---
import { sitePath } from '../utils/paths';
interface Props {
  descriptionId?: string;
}

const { descriptionId = 'comparison-description' } = Astro.props;
---

<div class="theory-visual" data-source={sitePath('pdhg-comparison.json')}>
  <canvas
    width="1000"
    height="900"
    role="img"
    aria-describedby={descriptionId}
    aria-label="Three methods on the bilinear saddle-point problem min x max y xy. State trajectories above and KKT residual below. Blue dots: PDHG. Green dashes: restarted averaged PDHG. Burgundy: restarted reflected Halpern PDHG. Small hollow markers mark restart landings; brief arrows indicate resets."
  ></canvas>
  <div class="legend">
    <span class="blue">
      <span class="swatch dots" aria-hidden="true"></span>PDHG
    </span>
    <span class="green">
      <span class="swatch dash" aria-hidden="true"></span>Restarted averaged
      PDHG
    </span>
    <span class="halpern">
      <span class="swatch" aria-hidden="true"></span>Restarted reflected Halpern
      PDHG
    </span>
  </div>
  <p class="error" role="alert" hidden></p>
</div>
<script>
  import { initializeTheoryFigure } from '../lib/research/theory-figure.mjs';
  for (const root of document.querySelectorAll<HTMLElement>('.theory-visual')) {
    initializeTheoryFigure(root, window);
  }
</script>
<style>
  .theory-visual {
    --pdhg: #377aa5;
    --restarted: #168675;
    --halpern: var(--red);
    container-type: inline-size;
    color: var(--ink);
    font-family: var(--sans);
  }
  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1000 / 900;
    height: auto;
  }
  .legend {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 9px 18px;
    margin: 6px 0 8px;
    font-size: 12px;
    line-height: 1.5;
  }
  .legend span {
    white-space: nowrap;
  }
  .swatch {
    display: inline-block;
    width: 21px;
    height: 2px;
    vertical-align: middle;
    margin-right: 5px;
    background: currentColor;
  }
  .dash {
    background: repeating-linear-gradient(
      90deg,
      currentColor 0 8px,
      transparent 8px 16px
    );
  }
  .dots {
    height: 4px;
    background: radial-gradient(circle, currentColor 1.3px, transparent 1.5px) 0
      50%/8px 4px repeat-x;
  }
  .blue {
    color: var(--pdhg);
  }
  .green {
    color: var(--restarted);
  }
  .halpern {
    color: var(--halpern);
  }
  .error {
    font-size: 12px;
    text-align: center;
    color: var(--muted);
  }
  @container (max-width: 470px) {
    .legend {
      gap: 8px 14px;
      font-size: 11px;
    }
    .swatch {
      width: 16px;
      margin-right: 3px;
    }
  }
  [hidden] {
    display: none !important;
  }

  @container (min-width: 600px) {
    canvas {
      aspect-ratio: 1000 / 820;
    }
  }
</style>
