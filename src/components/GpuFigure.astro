---
import { sitePath } from '../utils/paths';
import matrix from '../../data/research/rail4284-figure.json';

const variables = (matrix.columns / 1_000_000).toFixed(2);
const constraints = matrix.rows.toLocaleString('en-US');
const nonzeros = (matrix.nonzeros / 1_000_000).toFixed(2);
---

<div class="gpu-container">
  <div class="gpu-composition">
    <div class="rail-scene">
      <img
        src={sitePath('images/research/railway-oakland.webp')}
        width="1280"
        height="823"
        alt="Aerial view of railway tracks and yards in West Oakland."
        decoding="async"
      />
      <span class="scene-title">Railway systems</span>
    </div>
    <div class="matrix-panel">
      <div class="matrix-artwork">
        <img
          class="matrix-image"
          src={sitePath('images/research/rail4284-density.png')}
          width="720"
          height="560"
          alt="Nonzero density of the rail4284 constraint matrix in original ordering."
          loading="lazy"
          decoding="async"
        />
        <div class="matrix-title">
          Large-scale LP <span>rail4284</span>
        </div>
      </div>
      <div class="matrix-stats">
        <span>
          {variables} million <small>variables</small>
        </span>
        <span>
          {constraints} <small>constraints</small>
        </span>
        <span>
          {nonzeros} million <small>nonzeros</small>
        </span>
      </div>
    </div>
    <div class="gpu-platform">
      <img
        src={sitePath('images/research/gpu-platform.webp')}
        width="1536"
        height="1024"
        alt="Illustration of a multi-GPU computing platform."
        loading="lazy"
        decoding="async"
      />
      <span>GPU computing</span>
    </div>
  </div>
</div>
<style>
  .gpu-container {
    container-type: inline-size;
  }
  .gpu-composition {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.02;
    margin-top: 12px;
    isolation: isolate;
  }
  .rail-scene {
    position: absolute;
    inset: 0 0 auto;
    height: 58.5%;
    overflow: hidden;
  }
  .rail-scene img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 48% 48%;
    filter: saturate(0.3) contrast(1.06);
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 35%,
      rgb(0 0 0 / 0.72) 61%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      #000 35%,
      rgb(0 0 0 / 0.72) 61%,
      transparent 100%
    );
  }
  .rail-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.18), transparent 35%);
    -webkit-mask-image: linear-gradient(#000, transparent 65%);
    mask-image: linear-gradient(#000, transparent 65%);
    pointer-events: none;
  }
  .scene-title {
    position: absolute;
    z-index: 1;
    top: 20px;
    left: 22px;
    color: white;
    font-size: 15px;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.5);
  }
  .matrix-panel {
    position: absolute;
    left: 0;
    top: 36.7%;
    width: 57%;
  }
  .matrix-artwork {
    position: relative;
  }
  .matrix-title {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    gap: 7px;
    padding: 3px 6px;
    font-size: 12px;
    line-height: 1.4;
    background: var(--red);
    color: white;
  }
  .matrix-title span {
    font-size: 11px;
    color: white;
  }
  .matrix-image {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .matrix-stats {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 12px;
    font-size: 14px;
    color: var(--red);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }
  .matrix-stats > span {
    display: grid;
    grid-template-columns: 92px auto;
    align-items: baseline;
    column-gap: 10px;
  }
  .matrix-stats small {
    font-size: 11px;
    color: var(--muted);
  }
  .gpu-platform {
    position: absolute;
    z-index: 3;
    right: -2%;
    top: 55%;
    width: 66%;
    text-align: right;
  }
  .gpu-platform img {
    display: block;
    width: 100%;
    height: auto;
  }
  .gpu-platform > span {
    position: absolute;
    right: 7%;
    bottom: 5%;
    display: block;
    font-size: 12px;
    line-height: 1.4;
    color: var(--ink);
  }
  @container (max-width: 480px) {
    .scene-title {
      font-size: 13px;
      top: 14px;
      left: 16px;
    }
    .matrix-title {
      font-size: 11px;
      gap: 6px;
      padding: 3px 5px;
    }
    .matrix-stats {
      font-size: 12px;
      margin-top: 9px;
      gap: 5px;
    }
    .matrix-stats > span {
      grid-template-columns: 79px auto;
      column-gap: 6px;
    }
    .matrix-stats small {
      font-size: 11px;
    }
    .gpu-platform > span {
      font-size: 11px;
      right: 4px;
      bottom: 2px;
    }
  }
  @container (max-width: 320px) {
    .gpu-composition {
      aspect-ratio: 1 / 1.3;
    }
    .gpu-platform > span {
      position: static;
      margin-top: 4px;
    }
  }
</style>
