---
import { sitePath } from '../utils/paths';
import { MATRIX, SCAN_BAND } from '../lib/research/gpu-layout';
interface Props {
  maskId: string;
}
const { maskId } = Astro.props;
---

<div class="gpu-study">
  <svg
    viewBox="0 85 600 365"
    role="img"
    aria-label="Matrix products Ax and A transpose y on rail4284. Bars show RMS magnitudes of contiguous entries with a fixed logarithmic scale per vector. The y input is perturbed for illustration, not a continuous solver trajectory."
  >
    <defs>
      <mask id={maskId}>
        <image
          href={sitePath('images/research/rail4284-density.png')}
          x={MATRIX.x}
          y={MATRIX.y}
          width={MATRIX.width}
          height={MATRIX.height}
          preserveAspectRatio="none"
          style="filter:invert(1) brightness(1.25)"
        />
      </mask>
      <linearGradient id={`${maskId}-scan-down`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--scan)" stop-opacity="0" />
        <stop offset=".5" stop-color="var(--scan)" stop-opacity="1" />
        <stop offset="1" stop-color="var(--scan)" stop-opacity="0" />
      </linearGradient>
      <linearGradient id={`${maskId}-scan-right`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--scan)" stop-opacity="0" />
        <stop offset=".5" stop-color="var(--scan)" stop-opacity="1" />
        <stop offset="1" stop-color="var(--scan)" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g data-vector="x">
      <text x="73" y="129" text-anchor="end" class="formula">
        x
      </text>
      {Array.from({ length: 96 }, (_, i) => (
        <rect
          data-x
          x={MATRIX.x + (i * MATRIX.width) / 96}
          y="114"
          width="3.5"
          height="21"
          fill="var(--red)"
        />
      ))}
    </g>
    <g mask={`url(#${maskId})`}>
      <rect class="matrix-density" {...MATRIX} />
    </g>
    <!-- A separate density-masked pass strengthens only existing nonzero marks. -->
    <g mask={`url(#${maskId})`}>
      <rect
        data-matrix-scan="down"
        x={MATRIX.x}
        y={MATRIX.y - SCAN_BAND.height}
        width={MATRIX.width}
        height={SCAN_BAND.height}
        fill={`url(#${maskId}-scan-down)`}
        opacity="0"
      />
      <rect
        data-matrix-scan="right"
        x={MATRIX.x - SCAN_BAND.width}
        y={MATRIX.y}
        width={SCAN_BAND.width}
        height={MATRIX.height}
        fill={`url(#${maskId}-scan-right)`}
        opacity="0"
      />
    </g>
    <g data-vector="a">
      <text x="567" y="255" class="formula">
        Ax
      </text>
      {Array.from({ length: 72 }, (_, i) => (
        <rect
          data-a
          x="531"
          y={MATRIX.y + (i * MATRIX.height) / 72}
          width="24"
          height="2.6"
          fill="var(--red)"
        />
      ))}
    </g>
    <g data-vector="y">
      <text x="57" y="135" text-anchor="middle" class="formula">
        y
      </text>
      {Array.from({ length: 72 }, (_, i) => (
        <rect
          data-y
          x="45"
          y={MATRIX.y + (i * MATRIX.height) / 72}
          width="24"
          height="2.6"
          fill="var(--red)"
        />
      ))}
    </g>
    <g data-vector="at">
      <text x="73" y="417" text-anchor="end" class="formula">
        Aᵀy
      </text>
      {Array.from({ length: 96 }, (_, i) => (
        <rect
          data-at
          x={MATRIX.x + (i * MATRIX.width) / 96}
          y="401"
          width="3.5"
          height="21"
          fill="var(--red)"
        />
      ))}
    </g>
    <g data-flow="a" fill="none" stroke="#9d5b65" stroke-width=".85">
      {Array.from({ length: 10 }, (_, i) => (
        <g stroke-linecap="round" stroke-linejoin="round">
          <path
            d={`M${106 + i * 43} 139v8m-2.5-3 2.5 3 2.5-3`}
            stroke="white"
            stroke-width="2.3"
            stroke-opacity=".8"
          />
          <path d={`M${106 + i * 43} 139v8m-2.5-3 2.5 3 2.5-3`} />
        </g>
      ))}
      {Array.from({ length: 8 }, (_, i) => (
        <g data-flow-output="a" stroke-linecap="round" stroke-linejoin="round">
          <path
            d={`M519 ${166 + i * 29}h8m-3-2.5 3 2.5-3 2.5`}
            stroke="white"
            stroke-width="2.3"
            stroke-opacity=".8"
          />
          <path d={`M519 ${166 + i * 29}h8m-3-2.5 3 2.5-3 2.5`} />
        </g>
      ))}
    </g>
    <g data-flow="at" fill="none" stroke="#9d5b65" stroke-width=".85">
      {Array.from({ length: 8 }, (_, i) => (
        <g stroke-linecap="round" stroke-linejoin="round">
          <path
            d={`M73 ${166 + i * 29}h8m-3-2.5 3 2.5-3 2.5`}
            stroke="white"
            stroke-width="2.3"
            stroke-opacity=".8"
          />
          <path d={`M73 ${166 + i * 29}h8m-3-2.5 3 2.5-3 2.5`} />
        </g>
      ))}
      {Array.from({ length: 10 }, (_, i) => (
        <g data-flow-output="at" stroke-linecap="round" stroke-linejoin="round">
          <path
            d={`M${106 + i * 43} 389v8m-2.5-3 2.5 3 2.5-3`}
            stroke="white"
            stroke-width="2.3"
            stroke-opacity=".8"
          />
          <path d={`M${106 + i * 43} 389v8m-2.5-3 2.5 3 2.5-3`} />
        </g>
      ))}
    </g>
  </svg>
</div>

<style>
  [data-x],
  [data-y],
  [data-a],
  [data-at] {
    paint-order: stroke fill;
    stroke: rgb(255 255 255 / 0.6);
    stroke-width: 0.65px;
  }
  .matrix-density {
    fill: var(--red);
    opacity: 1;
  }
  .gpu-study {
    --scan: #a30b2e;
    width: 100%;
    margin-top: 0;
  }
  svg {
    display: block;
    width: 100%;
    font-family: inherit;
  }
  text {
    fill: #777276;
    font-size: 12px;
  }

  .formula {
    paint-order: stroke fill;
    stroke: rgb(255 255 255 / 0.6);
    stroke-width: 1.4px;
    stroke-linejoin: round;
    fill: var(--red);
    font-size: 15px;
  }
</style>
