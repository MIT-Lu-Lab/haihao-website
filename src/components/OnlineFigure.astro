---
import { sitePath } from '../utils/paths';
import OnlineDiagram from './OnlineDiagram.astro';
interface Props {
  id?: string;
}
const { id = 'online-comparison' } = Astro.props;
---

<div class="online-art" data-online-art>
  <div class="commerce-photo">
    <img
      src={sitePath('images/research/online-commerce.webp')}
      alt="Online shopping on a laptop"
      width="1120"
      height="747"
      loading="lazy"
      decoding="async"
    />
    <span>Online advertising</span>
  </div>
  <div class="online-heading">
    <span>Bidding with a budget.</span>
    <p>Dual mirror descent</p>
  </div>
  <OnlineDiagram id={id} />
</div>
<style>
  .online-art {
    width: 100%;
    color: var(--ink);
    container-type: inline-size;
  }
  .commerce-photo {
    height: 205px;
    position: relative;
    overflow: hidden;
  }
  .commerce-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 48%;
  }
  .commerce-photo span {
    position: absolute;
    top: 18px;
    left: 18px;
    background: var(--red);
    color: var(--surface);
    padding: 5px 10px;
    font-size: 12px;
  }
  .online-heading {
    position: relative;
    display: flex;
    width: fit-content;
    flex-direction: column;
    margin-top: -78px;
    background: var(--surface);
    padding: 14px 26px 12px 18px;
    max-width: calc(100% - 24px);
    gap: 7px;
  }
  .online-heading > span {
    font-family: var(--serif);
    font-size: clamp(28px, 2.6vw, 35px);
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--red);
  }
  .online-heading p {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--muted);
    margin: 0;
  }
  @container (max-width: 420px) {
    .commerce-photo {
      height: 185px;
    }
    .online-heading {
      padding-left: 12px;
      padding-right: 18px;
      max-width: calc(100% - 12px);
      margin-top: -66px;
    }
    .online-heading > span {
      font-size: 28px;
    }
  }
</style>
<script>
  import { initializeOnlineFigure } from '../lib/research/online-figure';
  import simulation from '../../data/research/online-allocation.json';
  document
    .querySelectorAll<HTMLElement>('[data-online-art]')
    .forEach((root) => {
      initializeOnlineFigure(root, simulation);
    });
</script>
