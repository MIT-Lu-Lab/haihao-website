---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/site';
import ExternalLink from '../components/ExternalLink.astro';
---
<Layout title="Teaching">
  <PageHeading title="Teaching"><p>Selected courses in optimization and analytics.</p></PageHeading>
  <div class="content-page prose">
    <section class="content-section">
      <p class="eyebrow">MIT Sloan School of Management</p>
      <h2>The Analytics Edge</h2>
      <p>15.071 · Spring 2025</p>
      <h2>Optimization</h2>
      <p>15.C57 / 15.C571 / 6.C57 / 6.C571 / IDS.C57 · Fall 2024</p>
    </section>
    <section class="content-section">
      <p class="eyebrow">University of Chicago Booth School of Business</p>
      <h2>Data Analysis with R and Python</h2>
      <p>BUSN 32100 · 2021–2024</p>
      <h2>Modern Large-Scale Optimization: Theory and Computation</h2>
      <p>BUSN 36919 · Spring 2023</p>
    </section>
    <ExternalLink class="text-link" href={profile.cv} mark={false}>Full teaching history in my CV <Arrow /></ExternalLink>
  </div>
</Layout>
