---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { awards } from '../data/awards';
import { profile } from '../data/site';
import ExternalLink from '../components/ExternalLink.astro';
import { sitePath } from '../utils/paths';
---
<Layout>
  <div class="home-grid">
    <aside class="profile-sidebar" aria-label="Profile and contact information">
      <img class="portrait" src={sitePath('images/haihao-lu.webp')} alt="Haihao Lu" width="360" height="360" fetchpriority="high" />
      <div class="profile-details">
        <ExternalLink class="affiliation" href="https://mitsloan.mit.edu/" mark={false}>MIT Sloan School<br class="desktop-break" /> of Management</ExternalLink>
        <p class="institution">Massachusetts Institute<br class="desktop-break" /> of Technology</p>
        <div class="contact-details">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <address>100 Main Street, E62-585<br />Cambridge, MA 02142</address>
          <p class="assistant">Assistant: {profile.assistant.name}<br />
            <a href={`mailto:${profile.assistant.email}`}>{profile.assistant.email}</a></p>
        </div>
        <div class="profile-links">
          <ExternalLink href={profile.scholar}>Google Scholar</ExternalLink>
          <ExternalLink href={profile.cv} mark={false}>Curriculum vitae <span class="file-label">PDF</span></ExternalLink>
        </div>
      </div>
    </aside>
    <div class="home-content">
      <p class="eyebrow">Optimization · Computation · Data science</p>
      <h1>Haihao Lu</h1>
      <p class="position">Cecil and Ida Green Career Development Assistant Professor<br />Assistant Professor of Operations Research &amp; Statistics</p>
      <div class="biography prose">
        <p>I am an Assistant Professor at the <ExternalLink href="https://mitsloan.mit.edu/" mark={false}>MIT Sloan School of Management</ExternalLink> and a part-time faculty researcher at Google Research. My research connects optimization, computation, and data science. I develop theory, algorithms, and software for large-scale decision-making, linking mathematical insights with modern computing and practical impact.</p>
        <p>Before joining MIT, I was an Assistant Professor at the University of Chicago Booth School of Business and spent one year as a postdoctoral researcher at Google Research. I received my PhD in Mathematics and Operations Research from MIT in 2019.</p>
      </div>
      <section class="home-research" aria-labelledby="research-heading">
        <div class="section-heading"><h2 id="research-heading">Research interests</h2><a class="text-link" href={sitePath('research/')}>Explore research <Arrow /></a></div>
        <div class="research-grid">
          <a class="research-summary" href={sitePath('research/#gpu-optimization')}>
            <h3>GPU-accelerated optimization <Arrow /></h3>
            <p>Algorithms and solvers for large-scale mathematical programming on GPUs and other modern computing architectures.</p>
          </a>
          <a class="research-summary" href={sitePath('research/#first-order-theory')}>
            <h3>First-order optimization theory <Arrow /></h3>
            <p>Theory that explains algorithmic performance and guides the design of faster, more reliable first-order methods.</p>
          </a>
          <a class="research-summary" href={sitePath('research/#online-decision-making')}>
            <h3>Online decision-making <Arrow /></h3>
            <p>Resource allocation under uncertainty, with applications to automated bidding, budget pacing, and online advertising.</p>
          </a>
          <a class="research-summary" href={sitePath('research/#property-taxation')}>
            <h3>Fair property taxation <Arrow /></h3>
            <p>Machine learning and optimization methods that reduce regressivity in property assessments while preserving predictive accuracy.</p>
          </a>
        </div>
      </section>
      <section class="recognition" aria-labelledby="recognition-heading">
        <h2 id="recognition-heading">Awards</h2>
        <ul>
          {awards.map(award => (
            <li><span class="honor-year">{award.year}</span><span>{award.title}</span></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>
