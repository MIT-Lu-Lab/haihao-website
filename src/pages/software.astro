---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { software } from '../data/software';
---
<Layout title="Software" description="Open-source optimization solvers and libraries from Haihao Lu's group at MIT Sloan.">
  <PageHeading title="Software">
    <p>Open-source solvers and libraries for large-scale optimization.</p>
  </PageHeading>
  <div class="software-page">
    <div class="software-grid">
      {software.map(project => (
        <section class="content-section">
          <h2>{project.name}</h2>
          <p>{project.description}</p>
          <a class="text-link" href={project.repo}>GitHub <span aria-hidden="true">↗</span></a>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .software-page {
    padding-bottom: var(--space-page);
  }

  .software-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-section);
    row-gap: var(--space-xl);
  }

  /* The grid supplies the vertical rhythm; each entry keeps only its own rule. */
  .software-grid .content-section {
    margin-top: 0;
    padding-top: var(--space-md);
  }

  .software-grid p {
    font-size: var(--text-ui);
    color: var(--muted);
    margin-bottom: var(--space-md);
  }

  @media (max-width: 760px) {
    .software-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
