---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import publications from '../data/publications.json';
const projects = [
  { name: 'cuPDLP.jl', prefix: 'cuPDLP.jl:', description: 'A GPU implementation of restarted primal-dual hybrid gradient for linear programming in Julia.' },
  { name: 'cuPDLPx', prefix: 'cuPDLPx:', description: 'A further enhanced GPU-based first-order solver for linear programming.' },
  { name: 'MPAX', prefix: 'MPAX:', description: 'Mathematical programming in JAX.' },
].map(project => ({ ...project, paper: publications.find(p => p.title.startsWith(project.prefix)) }));
---
<Layout title="Software">
  <PageHeading title="Software"><p>Computational tools for large-scale optimization.</p></PageHeading>
  <div class="content-page prose">
    {projects.map(project => <section class="content-section">
      <h2>{project.name}</h2>
      <p>{project.description}</p>
      {project.paper?.links[0] && <a class="text-link" href={project.paper.links[0].url}>Read the paper <Arrow /></a>}
    </section>)}
  </div>
</Layout>
