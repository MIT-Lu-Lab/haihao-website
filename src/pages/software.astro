---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { software } from '../data/software';
import ExternalLink from '../components/ExternalLink.astro';
import { profile } from '../data/site';
---
<Layout title="Software" description="Open-source optimization solvers and libraries from Haihao Lu's group at MIT Sloan.">
  <PageHeading title="Software">
    <p>Open-source solvers and libraries for large-scale optimization.</p>
    <p>More from the group on GitHub: <ExternalLink href={profile.github} mark={false}>github.com/MIT-Lu-Lab</ExternalLink></p>
  </PageHeading>
  <ul class="software-list">
    {software.map(project => (
      <li>
        <ExternalLink class="software-name" href={project.repo} mark={false}>{project.name}</ExternalLink>
        <span class="software-description">{project.description}</span>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .software-list {
    list-style: none;
    margin: 0;
    padding: var(--space-lg) 0 var(--space-page);
    border-top: 1px solid var(--line);
    display: grid;
    row-gap: var(--space-md);
  }

  .software-list li {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--space-md);
    align-items: baseline;
  }

  .software-list :global(.software-name) {
    font-weight: 600;
  }

  .software-description {
    font-size: var(--text-ui);
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .software-list li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
